{
  "name": "assign",
  "version": "0.0.0-development",
  "description": "GitHub Action to assign reviewers when dependencies are changed using dependency-owners",
  "author": "Kirk Eaton <contact@kirkeaton.ca>",
  "bugs": {
    "url": "https://github.com/dependency-owners/assign/issues"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "dependency-owners": "4.0.2"
  },
  "devDependencies": {
    "@dependency-owners/package-json-loader": "3.0.0",
    "@kirkeaton/prettier-config": "2.0.0",
    "@kirkeaton/tsconfig": "3.1.0",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "rolldown": "1.2.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/dependency-owners/assign#readme",
  "keywords": [
    "actions",
    "react",
    "setup"
  ],
  "license": "BSD-3-Clause",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dependency-owners/assign.git"
  },
  "scripts": {
    "build": "rolldown -c",
    "format": "prettier \"**/*.{js,json,md,ts}\" --write",
    "lint": "prettier \"**/*.{js,json,md,ts}\" --check",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
